					"name": "Get All Theatres",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/theatres",
							"host": ["{{baseUrl}}"],
							"path": ["api", "theatres"]
						}
					}
				},
				{
					"name": "Search Shows by City / Movie",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/shows?city=Bengaluru",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shows"],
							"query": [
								{ "key": "city", "value": "Bengaluru" }
							]
						}
					}
				},
				{
					"name": "Get Live Seat Availability for Show",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/shows/1/seats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shows", "1", "seats"]
						}
					}
				}
			]
		},
		{
			"name": "3. Booking Flow (User)",
			"item": [
				{
					"name": "Book Seats for Show",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{userToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"showId\": 1,\n    \"seatIds\": [1, 2]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings"]
						}
					}
				},
				{
					"name": "Get My Bookings",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{userToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/bookings?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings"]
						}
					}
				},
				{
					"name": "Get Booking by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{userToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "1"]
						}
					}
				},
				{
					"name": "Cancel Booking",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{userToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/1/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "1", "cancel"]
						}
					}
				}
			]
		},
		{
