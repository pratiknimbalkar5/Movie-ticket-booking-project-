# Database Configuration (Set in application-local.properties or as system environment variables)
DB_USERNAME=your_mysql_username_here
DB_PASSWORD=your_mysql_password_here

# JWT Signing Secret (Minimum 256 bits / 32 characters long)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters_length!

# TMDB API Read Access Token (From TMDB Settings -> API -> "API Read Access Token")
# In Windows PowerShell: $env:TMDB_ACCESS_TOKEN="your_token_here"
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Optional: TMDB API Key v3 fallback
# In Windows PowerShell: $env:TMDB_API_KEY="your_api_key_here"
TMDB_API_KEY=your_tmdb_api_key_here

# Google Places API Key (For Google Places API (New) cinema discovery)
# In Windows PowerShell: $env:GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Open Cinema Platform API Key (For Open Cinema Platform discovery & repertory/independent listings)
# In Windows PowerShell: $env:OPEN_CINEMA_API_KEY="your_open_cinema_api_key_here"
OPEN_CINEMA_API_KEY=your_open_cinema_api_key_here


