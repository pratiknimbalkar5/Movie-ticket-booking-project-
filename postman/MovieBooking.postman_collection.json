							"raw": "{\n    \"title\": \"Dune: Part Two\",\n    \"description\": \"Paul Atreides unites with Chani and the Fremen.\",\n    \"genre\": \"Sci-Fi\",\n    \"durationMinutes\": 166,\n    \"language\": \"English\",\n    \"releaseDate\": \"2024-03-01\"\n}"
